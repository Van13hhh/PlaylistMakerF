<resources >
    <!-- Base application theme. -->
    <style name="Base.Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="android:colorBackground">@color/YPBlack</item>
        <item name="colorPrimary">@color/background_setting_activity</item>
        <item name="searchIcon">@drawable/ic_night_search</item>
        <item name="mediaIcon">@drawable/ic_night_media</item>
        <item name="settingsIcon">@drawable/ic_dark_settings</item>
    </style>
    <style name="Theme.PlaylistMaker.Main" parent="Base.Theme.PlaylistMaker">
        <item name="colorPrimary">@color/background_setting_activity</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="Theme.PlaylistMaker.Settings" parent="Base.Theme.PlaylistMaker">
        <item name="colorPrimary">@color/background_setting_activity</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/blue</item>
        <item name="colorOnSecondary">@color/white</item>

    </style>
    <style name="Button_settings" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:layout_marginTop">@dimen/indentation_19</item>
        <item name="android:layout_marginEnd">@dimen/indentation_12</item>
        <item name="android:gravity">center</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="Theme.PlaylistMaker.Search" parent="Base.Theme.PlaylistMaker">
        <item name="colorPrimary">@color/YPBlack</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/white</item>
        <item name="colorOnSecondary">@color/YPBlack</item>
        <item name="placeHolderRV">@drawable/placeholder_rv_45x45</item>
        <item name="colorControlActivated">@color/YPBlue</item>
        <item name="internetErrorImg">@drawable/internet_error_120x120</item>
        <item name="emptyErrorImg">@drawable/empty_error_120x120</item>
        <item name="trackColor">@color/white</item>
    </style>

    <style name="Theme.PlaylistMaker.AudioPlayer" parent="Base.Theme.PlaylistMaker">
        <item name="colorPrimary">@color/YPBlack</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/white</item>
        <item name="colorOnSecondary">@color/YPBlack</item>
        <item name="playlistButtonSrc">@drawable/button_audioplayer_51x51</item>
        <item name="playlistLikeButtonSrc">@drawable/button_like_51x51</item>
        <item name="playlistPlaceHolder">@drawable/placeholder_ap_312x312</item>
    </style>
    <style name="Theme.PlaylistMaker.Search.Text" parent="Base.Theme.PlaylistMaker">
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="Theme.PlaylistCreating" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:textColorPrimary">@color/white</item>
    </style>
    </resources>