<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/blue"
    android:orientation="vertical"


    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/tf_indentation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/f_indentation"
            android:layout_marginTop="@dimen/f_indentation"
            android:layout_marginEnd="52dp"
            android:layout_marginBottom="@dimen/f_indentation">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/tw_indentation"
                android:layout_marginTop="@dimen/t_indentation"
                android:layout_marginBottom="@dimen/tw_indentation"
                android:gravity="center_vertical"
                android:text="@string/plm_text"
                android:textColor="@color/white"
                android:textSize="@dimen/medium"
                android:fontFamily="@font/ys_display_medium"
                />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_search"
        android:text="@string/search"
        app:icon="@drawable/search"
        style="@style/Button_ma_style"/>

    <Button
        android:id="@+id/btn_media"
        android:text="@string/my_text_lowercase"
        app:icon="@drawable/musicicon"
        style="@style/Button_ma_style"/>
    <Button
        android:id="@+id/btn_settings"
        android:text="@string/settings"
        app:icon="@drawable/settings"
        style="@style/Button_ma_style"
        android:layout_marginBottom="28dp"
        />


</LinearLayout>