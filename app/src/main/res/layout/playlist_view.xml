<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:theme="@style/Theme.PlaylistMaker.Search">

    <ImageView
        android:id="@+id/iv_playlist_photo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:scaleType="centerCrop"
        android:background="@drawable/rounded_corners"
        android:clipToOutline="true" />

    <TextView
        android:id="@+id/tv_playlist_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_playlist_photo"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="?attr/colorOnPrimary"
        android:fontFamily="@font/ys_display_regular"
        android:text="Summer Party" />

    <TextView
        android:id="@+id/tv_playlist_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_playlist_name"
        android:textSize="12sp"
        android:textColor="?attr/colorOnPrimary"
        android:fontFamily="@font/ys_display_regular"
        android:text="2 tracks" />

</androidx.constraintlayout.widget.ConstraintLayout>