<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:theme="@style/Theme.PlaylistMaker.Search">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/indentation_4"
            android:layout_marginTop="@dimen/indentation_4"
            android:layout_marginEnd="@dimen/indentation_24"
            android:layout_marginBottom="@dimen/indentation_4"
           >

            <Button
                android:id="@+id/back_to_main_menu_search"
                android:layout_width="@dimen/indentation_48"
                android:layout_height="@dimen/indentation_48"
                android:layout_gravity="center_horizontal"
                android:background="@android:color/transparent"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="@dimen/indentation_12"
                android:paddingTop="@dimen/indentation_12"
                android:paddingEnd="@dimen/indentation_12"
                android:paddingBottom="@dimen/indentation_12"
                app:icon="@drawable/ic_left_arrow_24x24"
                app:iconTint="?attr/colorOnPrimary" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/indentation_48">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="@dimen/indentation_12"
                    android:layout_marginTop="@dimen/indentation_10"
                    android:layout_marginEnd="84dp"
                    android:layout_marginBottom="@dimen/indentation_12"
                    android:fontFamily="@font/ys_display_medium"
                    android:gravity="center_vertical"
                    android:text="@string/mediateka"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="@dimen/medium22" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:tabTextColor="?attr/colorOnPrimary"
        app:tabIndicatorColor="?attr/colorOnPrimary"
        app:tabTextAppearance="@style/TabText"
        />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />

</LinearLayout>