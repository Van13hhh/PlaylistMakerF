<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:theme="@style/Theme.PlaylistMaker.Search">

    <ImageView
        android:id="@+id/iv_playlist_photo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/rounded_corners"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/tv_playlist_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="?attr/colorOnPrimary"
        android:fontFamily="@font/ys_display_regular"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:text="Summer Party"
        app:layout_constraintStart_toEndOf="@id/iv_playlist_photo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_playlist_photo"
        app:layout_constraintBottom_toTopOf="@id/tv_playlist_count"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_playlist_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:textSize="12sp"
        android:textColor="?attr/trackColor"
        android:fontFamily="@font/ys_display_regular"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:text="2 tracks"
        app:layout_constraintStart_toStartOf="@id/tv_playlist_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_playlist_name"
        app:layout_constraintBottom_toBottomOf="@id/iv_playlist_photo" />

</androidx.constraintlayout.widget.ConstraintLayout>