<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        style="@style/FrameLayout_sa_style"
        tools:ignore="ExtraText,MissingConstraints"
        android:id="@+id/fr_track">



        <ImageView
            android:id="@+id/iv_trackImage"
            android:layout_width="@dimen/indentation_45"
            android:layout_height="@dimen/indentation_45"
            android:layout_marginTop="@dimen/indentation_8"
            android:layout_marginBottom="@dimen/indentation_8"
            android:layout_marginStart="@dimen/indentation_13"
            android:background="@drawable/rounded_corners"
            />


        <LinearLayout
            android:theme="@style/Theme.PlaylistMaker.Search.Text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/indentation_66"
            android:layout_marginEnd="@dimen/indentation_44"
            android:layout_marginTop="@dimen/indentation_14"
            android:layout_marginBottom="@dimen/indentation_14"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/tv_trackName"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="?attr/colorPrimary"
                android:fontFamily="@font/ys_display_regular"
                android:textSize="@dimen/regular16"
                android:paddingBottom="@dimen/indentation_1"
                android:maxLines="1"
                android:ellipsize="end"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tv_authorName"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:textSize="@dimen/regular11"
                    android:textColor="?attr/colorOnPrimary"
                    android:fontFamily="@font/ys_display_regular"
                    android:maxLines="1"
                    android:ellipsize="end"
                    />
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic"
                    app:tint="?attr/colorOnPrimary"
                    />
                <TextView
                    android:id="@+id/trackTime"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:textSize="@dimen/regular11"
                    android:textColor="?attr/colorOnPrimary"
                    android:fontFamily="@font/ys_display_regular"
                    android:maxLines="1"
                    android:ellipsize="end"
                    />
            </LinearLayout>

        </LinearLayout>

        <Button
            style="@style/Button_settings"
            android:id="@+id/btn_user_agreement"
            app:icon="@drawable/ic_arrow_forward_8x14"
            android:paddingStart="@dimen/indentation_8"
            android:paddingEnd="@dimen/indentation_8"
            android:paddingTop="@dimen/indentation_5"
            android:paddingBottom="@dimen/indentation_5"
            android:background="@android:color/transparent"
            />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>