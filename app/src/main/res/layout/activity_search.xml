<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_search"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:theme="@style/Theme.PlaylistMaker.Search">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/indentation_4"
            android:layout_marginTop="@dimen/indentation_4"
            android:layout_marginEnd="@dimen/indentation_24"
            android:layout_marginBottom="@dimen/indentation_4">

            <Button
                android:foreground="?attr/selectableItemBackground"
                android:id="@+id/back_to_main_menu_search"
                android:layout_width="@dimen/indentation_48"
                android:layout_height="@dimen/indentation_48"
                android:layout_gravity="center_horizontal"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:paddingStart="@dimen/indentation_12"
                android:paddingTop="@dimen/indentation_12"
                android:paddingEnd="@dimen/indentation_12"
                android:paddingBottom="@dimen/indentation_12"
                app:icon="@drawable/ic_left_arrow_24x24"
                app:iconTint="?attr/colorOnPrimary"
                />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/indentation_48">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="@dimen/indentation_12"
                    android:layout_marginTop="@dimen/indentation_10"
                    android:layout_marginEnd="84dp"
                    android:layout_marginBottom="@dimen/indentation_12"
                    android:fontFamily="@font/ys_display_medium"
                    android:gravity="center_vertical"
                    android:text="@string/search"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="@dimen/medium22" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/ed_text_search"
            style="@style/EditText.Style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:layout_marginEnd="16dp"
            android:textCursorDrawable="@drawable/cursor"
            android:textColorHighlight="@color/TakeCursorBlue"
            />

        <Button
            android:id="@+id/clearIcon"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/indentation_16"
            android:background="@android:color/transparent"
            android:foreground="@drawable/ic_cross_12x12"
            android:foregroundGravity="center"
            android:foregroundTint="?attr/colorOnSecondary"
            />

    </FrameLayout>

    <ImageView
        android:id="@+id/iv_error"
        tools:src="@drawable/empty_error_light_120x120"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="102dp"
        android:layout_marginStart="120dp"
        android:layout_marginEnd="120dp"
        android:visibility="gone"
        />
    <TextView
        android:id="@+id/tv_error"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="@dimen/indentation_19"
        android:fontFamily="@font/ys_display_medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:visibility="gone"
        />

    <Button
        android:id="@+id/btn_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="?attr/colorOnPrimary"
        android:layout_marginTop="24dp"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/ys_display_medium"
        android:textSize="@dimen/indentation_14"
        app:cornerRadius="54sp"
        android:textAllCaps="false"
        android:letterSpacing="0"
        android:textColor="?attr/colorPrimary"
        android:text="Обновить"
        android:visibility="gone"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search"
        android:layout_marginTop="@dimen/indentation_16"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/LL_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/indentation_24"
        android:orientation="vertical"
        android:visibility="gone">
        <FrameLayout
            android:id="@+id/history_fr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/history_text"
                android:fontFamily="@font/ys_display_medium"
                android:textSize="19sp"
                android:gravity="center_horizontal"
                android:textColor="?attr/colorOnPrimary"
                android:layout_marginHorizontal="@dimen/indentation_16"
                android:layout_marginTop="@dimen/indentation_18"
                android:layout_marginBottom="@dimen/indentation_12"/>
        </FrameLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/indentation_8"
            android:layout_weight="1">
        </androidx.recyclerview.widget.RecyclerView>
        <Button
            android:layout_marginTop="@dimen/indentation_24"
            android:id="@+id/history_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:text="@string/history_button"
            android:fontFamily="@font/ys_display_medium"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary"
            android:backgroundTint="?attr/colorOnPrimary"
            app:cornerRadius="54sp"
            android:layout_gravity="center_horizontal"
            android:letterSpacing="0"/>
    </LinearLayout>

</LinearLayout>