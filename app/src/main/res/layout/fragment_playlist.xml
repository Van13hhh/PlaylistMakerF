<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nestedScrollViewAudioplayer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/YPLightGrey"
    android:theme="@style/Theme.PlaylistMaker.AudioPlayer"
    tools:context=".ui.audioplayer.fragments.AudioPlayerFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/YPLightGrey">

        <Button
            android:id="@+id/backToListOfPlaylists"
            android:layout_width="@dimen/indentation_48"
            android:layout_height="@dimen/indentation_48"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:paddingStart="@dimen/indentation_12"
            android:paddingEnd="@dimen/indentation_12"
            android:paddingBottom="@dimen/indentation_12"
            app:icon="@drawable/ic_left_arrow_24x24"
            app:iconTint="@color/YPBlack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints" />

        <ImageView
            android:id="@+id/playlistImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription,MissingConstraints"
            tools:src="@drawable/album_1" />

        <TextView
            android:id="@+id/playlistNameTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/indentation_16"
            android:layout_marginTop="@dimen/indentation_24"
            android:fontFamily="@font/ys_display_bold"
            android:textColor="@color/YPBlack"
            android:textSize="@dimen/indentation_sp_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/playlistImage"
            tools:text="Best songs 2021" />

        <TextView
            android:id="@+id/playlistDescriptionTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/indentation_16"
            android:layout_marginTop="@dimen/indentation_8"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="@color/YPBlack"
            android:textSize="@dimen/indentation_sp_18"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/playlistNameTv"
            tools:text="2022" />

        <TextView
            android:id="@+id/playlistTimeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/indentation_16"
            android:layout_marginTop="@dimen/indentation_8"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="@color/YPBlack"
            android:textSize="@dimen/indentation_sp_18"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/playlistDescriptionTv"
            tools:text="300 минут" />

        <ImageView
            android:id="@+id/separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/indentation_12"
            android:src="@drawable/ic"
            app:layout_constraintStart_toEndOf="@+id/playlistTimeTv"
            app:layout_constraintTop_toBottomOf="@id/playlistDescriptionTv"
            app:tint="@color/YPBlack"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/playlistCountTracksTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/indentation_8"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="@color/YPBlack"
            android:textSize="@dimen/indentation_sp_18"
            app:layout_constraintStart_toEndOf="@id/separator"
            app:layout_constraintTop_toBottomOf="@id/playlistDescriptionTv"
            tools:text="98 треков" />

        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/indentation_16"
            android:layout_marginTop="@dimen/indentation_19"
            android:background="@null"
            android:src="@drawable/btn_share_24x24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/playlistTimeTv"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/indentation_16"
            android:layout_marginTop="@dimen/indentation_16"
            android:background="@null"
            android:src="@drawable/btn_more_24x24"
            app:layout_constraintStart_toEndOf="@id/btnShare"
            app:layout_constraintTop_toBottomOf="@id/playlistTimeTv"
            app:tint="@color/YPBlack"
            tools:ignore="ContentDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/standardBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/rounded_bottom_sheet"
        android:orientation="vertical"
        app:behavior_hideable="false"
        android:visibility="visible"
        app:behavior_peekHeight="240dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/drag_handle_shape" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlaylistTracks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="400dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playlistBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_bottom_sheet"
        android:paddingBottom="@dimen/indentation_20"
        app:behavior_hideable="true"
        android:visibility="visible"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/drag_handle_shape" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/indentation_20">

            <ImageView
                android:id="@+id/ivPlaylistPhoto"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="@dimen/indentation_13"
                android:background="@drawable/rounded_corners"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPlaylistName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/ys_display_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="0dp"
                    android:maxLines="2"
                    android:text="Summer Party"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPlaylisCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ys_display_regular"
                    android:text="2 tracks"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="12sp" />

            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnShareBottomSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/indentation_8"
            android:paddingStart="@dimen/indentation_16"
            android:paddingVertical="@dimen/indentation_21"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share"
                android:textColor="?attr/colorOnPrimary"
                android:fontFamily="@font/ys_display_regular"
                android:textSize="@dimen/indentation_sp_16" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/indentation_16"
            android:paddingVertical="@dimen/indentation_21"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/redact"
                android:textColor="?attr/colorOnPrimary"
                android:fontFamily="@font/ys_display_regular"
                android:textSize="@dimen/indentation_sp_16" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/indentation_16"
            android:paddingVertical="@dimen/indentation_21"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete"
                android:textColor="?attr/colorOnPrimary"
                android:fontFamily="@font/ys_display_regular"
                android:textSize="@dimen/indentation_sp_16" />
        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>