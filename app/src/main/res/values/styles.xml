<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Button_ma_style" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">@dimen/indentation_16</item>
        <item name="android:layout_marginStart">@dimen/indentation_16</item>
        <item name="android:layout_marginBottom">@dimen/indentation_16</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_weight">500</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">20dp</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/indentation_8</item>
        <item name="iconTint">@color/black</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextView_sa_style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start</item>
        <item name="android:layout_marginStart">@dimen/indentation_16</item>
        <item name="android:layout_marginTop">@dimen/indentation_21</item>
        <item name="android:layout_marginBottom">@dimen/indentation_21</item>
        <item name="android:layout_marginEnd">@dimen/indentation_44</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/settings_text</item>
    </style>

    <style name="FrameLayout_sa_style">
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="Switch.Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:layout_marginTop">@dimen/indentation_10</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:layout_marginBottom">11dp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
    </style>
    <style name="EditText.Style" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:maxLines">1</item>
        <item name="android:hint">@string/search</item>
        <item name="android:inputType">text</item>
        <item name="android:paddingTop">8.5dp</item>
        <item name="android:paddingBottom">8.5dp</item>
        <item name="android:textColorHint">?attr/colorOnSecondary</item>
        <item name="android:layout_marginStart">@dimen/indentation_16</item>
        <item name="android:layout_marginTop">@dimen/e_padding</item>
        <item name="android:layout_marginBottom">@dimen/e_padding</item>
        <item name="android:backgroundTint">?attr/colorSecondary</item>
        <item name="android:background">@drawable/edittext_background</item>
        <item name="android:drawableStart">@drawable/ic_search_14x14</item>
        <item name="android:drawableTint">?attr/colorOnSecondary</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">@dimen/indentation_12</item>
        <item name="android:textColor">@color/YPBlack</item>
    </style>

    <style name="AudioPlayer.TextView" parent="Theme.PlaylistMaker">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/indentation_13</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="AudioPlayer.TextView2" parent="Theme.PlaylistMaker">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/indentation_13</item>
        <item name="android:textColor">@color/YP_text_Gray</item>
    </style>
</resources>
