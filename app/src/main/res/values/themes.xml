<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary> -->
        <item name="android:colorBackground">@color/white</item>
        <item name="searchIcon">@drawable/ic_light_search</item>
        <item name="mediaIcon">@drawable/ic_light_media</item>
        <item name="settingsIcon">@drawable/ic_light_settings</item>
    </style>

    <style name="Theme.PlaylistMaker" parent="Base.Theme.PlaylistMaker">
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/text_on_day_setting_activity</item>
    </style>
    <style name="Theme.PlaylistMaker.Main" parent="Base.Theme.PlaylistMaker">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>
    <style name="Theme.PlaylistMaker.Settings" parent="Base.Theme.PlaylistMaker">
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/switch_color</item>
        <item name="colorOnSecondary">@color/background_setting_activity</item>
    </style>

    <style name="Button_settings" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:layout_marginTop">@dimen/indentation_19</item>
        <item name="android:layout_marginEnd">@dimen/indentation_12</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="iconTint">@color/settings_button</item>
    </style>
    <style name="Theme.PlaylistMaker.Search" parent="Base.Theme.PlaylistMaker">
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/YPBlack</item>
        <item name="colorSecondary">@color/YPLightGrey</item>
        <item name="colorOnSecondary">@color/YPGray</item>
        <item name="placeHolderRV">@drawable/placeholder_45x45_day</item>
        <item name="colorControlActivated">@color/YPBlue</item>
        <item name="internetErrorImg">@drawable/internet_error_light_120x120</item>
        <item name="emptyErrorImg">@drawable/empty_error_light_120x120</item>
    </style>

    <style name="Theme.PlaylistMaker.AudioPlayer" parent="Base.Theme.PlaylistMaker">
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/YPBlack</item>
        <item name="colorSecondary">@color/YPLightGrey</item>
        <item name="colorOnSecondary">@color/YPGray</item>
        <item name="playlistButtonSrc">@drawable/button_audioplayer_51x51day</item>
        <item name="playlistLikeButtonSrc">@drawable/button_like_51x51_day</item>
        <item name="playlistPlaceHolder">@drawable/placeholder_ap_312x312_day</item>
    </style>

    <style name="Theme.PlaylistMaker.Search.Text" parent="Base.Theme.PlaylistMaker">
        <item name="colorPrimary">@color/black</item>
        <item name="colorOnPrimary">@color/settings_button</item>
    </style>
</resources>